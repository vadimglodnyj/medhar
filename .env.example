GEMINI_API_KEY=
# Якщо 503 / high demand — спробуйте gemini-3.1-flash-lite або gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash
# Тимчасовий токен з Dropbox App Console (sl.u.… живе лише ~4 години).
DROPBOX_ACCESS_TOKEN=
# Постійний доступ (рекомендовано) — тоді DROPBOX_ACCESS_TOKEN не потрібен:
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Хмарний шлях (не D:\...).
# App folder (Програми/patientss): залиште порожнім → D:\Dropbox\Програми\patientss\patients\...
# Full Dropbox: м-с → /м-с/patients/...
DROPBOX_ROOT_FOLDER=
