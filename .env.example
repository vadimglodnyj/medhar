GEMINI_API_KEY=
# Якщо 503 / high demand — спробуйте gemini-3.1-flash-lite або gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash
# Спільні Excel у локально синхронізованій папці Dropbox.
# Не задавайте — програма використовуватиме локальний data/.
# У режимі команди шлях підставляється з team.vault (PIN).
MEDHAR_EXCEL_DIR=
# Спільний амбулаторний журнал Turso. Обидва поля порожні = локальний SQLite.
# Для колег зручніше: scripts/build_team_vault.py + PIN (див. desktop/README.md).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# WhatsApp Business API для ручної відправки зі сторінки лікування.
# У режимі команди ці значення краще пакувати в team.vault.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_API_VERSION=v20.0
# Кеш списків журналу/картотеки в пам’яті (секунди). 0 = вимкнути.
# Власні зміни скидають кеш одразу; зміни колег підтягуються не пізніше TTL.
MEDHAR_CACHE_TTL_SEC=30
# Маніфест оновлення (за замовчуванням Dropbox /releases/update_manifest.json у режимі команди).
# MEDHAR_UPDATE_URL=dropbox:/releases/update_manifest.json
# MEDHAR_SKIP_UPDATE_PUBLISH=1  — не викладати Install.exe у Dropbox під час .\desktop\build.ps1
# Тимчасовий токен з Dropbox App Console (sl.u.… живе лише ~4 години).
DROPBOX_ACCESS_TOKEN=
# Постійний доступ (рекомендовано) — тоді DROPBOX_ACCESS_TOKEN не потрібен:
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Хмарний шлях (не D:\...).
# App folder (Програми/patientss): залиште порожнім → D:\Dropbox\Програми\patientss\patients\...
# Full Dropbox: м-с → /м-с/patients/...
DROPBOX_ROOT_FOLDER=
